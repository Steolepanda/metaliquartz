            "name": "Mixing Point",
            "order": 2,
            "portClass": "QCNumberPort",
            "QCPortAttributeDefaultValueKey": 0.5,
            "QCPortAttributeTypeKey": "QCPortTypeNumber",
            "valueClass": "NSNumber"
          }
        },
